import java.util.*;
public class Main
{
    public static void matrix(int n){
        char mat[][] = new char[n][n];
        for(int i = 0; i< n;i++){
            mat[0][i] = (char) (i + 'A');
            
        }
        for(int i =1 ; i < n ;i++){
            char val = mat[i - 1][ n - 1];
            for(int j = n - 1; j >= 1; j--){
                mat[i][j] = mat[i - 1][j - 1];
            }
            mat[i][0] = val;
        }
        for(int i = 0; i < n; i++){
            for(int j = 0; j < n ; j++){
                System.out.print(mat[i][j]+" ");
            }
            System.out.println();
        }
    }
	public static void main(String[] args) {
	    Scanner sc = new Scanner(System.in);
	    int n = sc.nextInt();
	    matrix(n);
	}
}
